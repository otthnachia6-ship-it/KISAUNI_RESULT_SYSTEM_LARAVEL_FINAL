APP_NAME="Result Management System"
APP_ENV=production
APP_KEY=
# ^ leave empty here. On the server run: php artisan key:generate (or keep the key already in the server .env). NEVER commit a real key.
APP_DEBUG=false
APP_URL=https://kisaunips.ostexs.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# MySQL database credentials for cPanel
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ostexs_results
DB_USERNAME=ostexs_dbuser
DB_PASSWORD=YourStrongPasswordHere

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# School System Configuration
DEFAULT_SCHOOL_NAME="Kisauni Primary School"
DEFAULT_ACADEMIC_YEAR="2026"
IDLE_TIMEOUT_MINUTES=10
# Database backups: cron (php artisan db:backup) + Developer Control Center (create/download, Developer only)
# BACKUP_PATH must be a private folder OUTSIDE public_html (empty = ../kisauni_backups next to the project)
BACKUP_PATH=
BACKUP_RETENTION_DAYS=90
BACKUP_MIN_KEEP=7

# Old Flask (Werkzeug scrypt) passwords: keep false until `php artisan auth:scrypt-benchmark` is acceptable on this hosting
LEGACY_SCRYPT_ENABLED=false
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5
# Wrong passwords are counted per username + device; one device may fail at most this many times in the lockout window
MAX_LOGIN_ATTEMPTS_PER_IP=50
# Shortest new password allowed (existing passwords keep working)
MIN_PASSWORD_LENGTH=4
# Days the Audit Log keeps its entries
AUDIT_LOG_RETENTION_DAYS=5
# Optional phone/e-mail shown on the maintenance and suspended pages (empty = hidden)
SUPPORT_CONTACT=
# Only for the very first `php artisan db:seed` on an empty database (leave empty = random password printed once)
INITIAL_HEADMASTER_PASSWORD=
APP_TIMEZONE="Africa/Dar_es_Salaam"
